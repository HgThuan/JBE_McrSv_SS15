{
	"info": {
		"_postman_id": "87e35b71-3cb5-4f40-9a28-ee580c80d45f",
		"name": "SS15 - Identity Service JWT & Refresh Token",
		"description": "Collection kiểm thử xác thực Spring Security + JJWT 0.11.5 (HS256, 15 phút, sub, role, jti) và Refresh Token 7 ngày trong PostgreSQL cho Session 15",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8085",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Login - Student (ROLE: STUDENT)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"",
							"pm.test(\"Response contains accessToken, refreshToken, expiresIn, role\", function () {",
							"    pm.expect(jsonData.accessToken).to.be.a('string');",
							"    pm.expect(jsonData.refreshToken).to.be.a('string');",
							"    pm.expect(jsonData.tokenType).to.eql('Bearer');",
							"    pm.expect(jsonData.expiresIn).to.eql(900);",
							"    pm.expect(jsonData.username).to.eql('student');",
							"    pm.expect(jsonData.role).to.eql('STUDENT');",
							"});",
							"",
							"// Lưu token vào biến collection",
							"pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
							"pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
							"",
							"// Phân tích Payload của Access Token trực tiếp trong Postman",
							"pm.test(\"JWT Payload contains sub, role, jti, exp, iat\", function () {",
							"    var parts = jsonData.accessToken.split('.');",
							"    pm.expect(parts.length).to.eql(3);",
							"    var payload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(parts[1])));",
							"    pm.expect(payload.sub).to.eql('student');",
							"    pm.expect(payload.role).to.eql('STUDENT');",
							"    pm.expect(payload.jti).to.be.a('string');",
							"    pm.expect(payload.exp - payload.iat).to.eql(900);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"student\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},

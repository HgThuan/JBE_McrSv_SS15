							"});",
							"",
							"pm.test(\"JWT Payload contains role: INSTRUCTOR\", function () {",
							"    var parts = jsonData.accessToken.split('.');",
							"    var payload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(parts[1])));",
							"    pm.expect(payload.sub).to.eql('instructor');",
							"    pm.expect(payload.role).to.eql('INSTRUCTOR');",
							"    pm.expect(payload.jti).to.be.a('string');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
